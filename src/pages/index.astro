---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TimelineItem from '../components/TimelineItem.astro';
import { site } from '../data/site.js';
---

<BaseLayout title={`${site.name} | Portfolio`} description={site.headline}>
  <a class="skip-link" href="#content">Skip to content</a>

  <div class="page">
    <header class="container nav">
      <a class="brand" href="#top" aria-label={`${site.name} home`}>
        <span class="brand-mark" aria-hidden="true"></span>
        <span>{site.name}</span>
      </a>
      <nav class="nav-links" aria-label="Primary">
        <a href="#projects">Projects</a>
        <a href="#about">About</a>
        <a href="#experience">Experience</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main id="content">
      <section class="hero">
        <div class="container hero-grid">
          <div>
            <p class="eyebrow" data-reveal>{site.location}</p>
            <p class="hero-role" data-reveal>{site.role}</p>
            <h1 data-reveal>{site.headline}</h1>
            <p class="lede" data-reveal>{site.intro}</p>
            <div class="hero-actions" data-reveal>
              <a class="button button--primary" href="#projects">View Projects</a>
              <a class="button button--secondary" href="mailto:asdevnath@gmail.com">Contact Me</a>
            </div>
          </div>

          <aside class="hero-panel" data-reveal>
            <div class="hero-panel__card">
              <span class="status-pill"><span class="status-dot"></span>{site.availability}</span>
            </div>

            <div class="stats">
              {site.stats.map((stat) => (
                <div class="stat">
                  <strong>{stat.value}</strong>
                  <span>{stat.label}</span>
                </div>
              ))}
            </div>

            <div class="hero-panel__card">
              <p class="lede" style="margin: 0;">
                Functional testing, API validation, and lightweight automation for releases that need confidence.
              </p>
            </div>
          </aside>
        </div>
      </section>

      <section class="section" id="projects">
        <div class="container">
          <SectionHeading
            eyebrow="Selected Projects"
            title="Project experience"
            description="A few real-world examples from your resume that show how you work across LMS, AI, and compliance products."
          />
          <div class="grid projects-grid">
            {site.projects.map((project) => <ProjectCard {...project} />)}
          </div>
        </div>
      </section>

      <section class="section" id="about">
        <div class="container">
          <SectionHeading
            eyebrow="About"
            title="QA delivery with clarity and confidence"
            description="The layout stays focused on practical strengths: test strategy, execution, collaboration, and release confidence."
          />
          <div class="grid about-grid">
            <article class="about-card" data-reveal>
              <p>
                Senior QA Test Engineer with 5 years of experience testing products that real users depend on
                every day, including student learning platforms, AI-assisted content tools, medical catalog
                workflows, and compliance applications.
              </p>
              <p>
                Strong in end-to-end functional testing, regression planning, defect triage, and release
                validation. Hands-on with Postman, JMeter, and starter-level Selenium automation using Java
                and TestNG.
              </p>
              <div class="skill-list" aria-label="Skills">
                {site.skills.map((skill) => <span>{skill}</span>)}
              </div>
            </article>

            <article class="about-card" data-reveal>
              <p class="eyebrow">Education & Certifications</p>
              <p>
                <strong>{site.education.degree}</strong><br />
                {site.education.school}
              </p>
              <p style="margin-top: 1rem;">
                {site.certifications.map((item) => item).join(' • ')}
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="section" id="experience">
        <div class="container">
          <SectionHeading
            eyebrow="Timeline"
            title="Experience"
            description="A compact timeline makes the resume easy to scan while still showing the depth of your QA background."
          />
          <div class="timeline">
            {site.experience.map((item) => <TimelineItem {...item} />)}
          </div>
        </div>
      </section>

      <section class="section" id="contact">
        <div class="container">
          <div class="contact-card" data-reveal>
            <SectionHeading
              eyebrow="Contact"
              title="Let's build something reliable"
              description={site.contactLine}
            />
            <div class="contact-row">
              <a class="button button--primary" href="mailto:asdevnath@gmail.com">Email Me</a>
              <a class="button button--secondary" href="#top">Back to top</a>
            </div>
            <div class="contact-links" aria-label="Social links">
              {site.socials.map((social) => (
                <a
                  href={social.href}
                  target={social.href.startsWith('http') ? '_blank' : undefined}
                  rel={social.href.startsWith('http') ? 'noreferrer' : undefined}
                >
                  {social.label}
                </a>
              ))}
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="container">
        <p>(c) {new Date().getFullYear()} {site.name}. QA portfolio built with Astro and ready for free hosting.</p>
      </div>
    </footer>
  </div>

  <script is:inline>
    const items = document.querySelectorAll('[data-reveal]');
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
    );

    items.forEach((item, index) => {
      item.style.setProperty('--reveal-delay', `${index * 70}ms`);
      observer.observe(item);
    });
  </script>
</BaseLayout>
